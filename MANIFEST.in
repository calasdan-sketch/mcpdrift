include .gitattributes LICENSE README.md CHANGELOG.md PUBLISH-CHECKLIST.md action.yml .pre-commit-hooks.yaml
recursive-include docs *.md
recursive-include bench *.py
recursive-include tests *.py *.json *.txt *.md *.sarif *.xml
recursive-include src/mcpdrift/examples *.json
global-exclude __pycache__ *.py[cod]
